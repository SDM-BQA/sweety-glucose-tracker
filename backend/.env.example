PORT=5000
NODE_ENV=development

# PostgreSQL connection (used when NODE_ENV !== 'test')
# Option A: a single connection string (e.g. Neon, Supabase, Render) - takes priority if set
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Option B: separate fields for a local/self-hosted Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
